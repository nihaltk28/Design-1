# Copy to .env.local and fill in — never commit .env.local (PROJECT-SETUP §12).

# Server-only. Backend base URL. Leave empty with NEXT_PUBLIC_USE_MOCKS=true to run on MSW fixtures.
API_BASE_URL=
# Shared secret the backend sends in the X-Revalidate-Secret header to POST /api/revalidate (webhook projects only).
# Long and random (e.g. `openssl rand -hex 32`); unset = the webhook refuses every call.
REVALIDATE_SECRET=
# true = all API calls answered by lib/mocks (MSW). Never true in production.
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_DEFAULT_LOCALE=
# Canonical site origin, e.g. https://www.example.gov.qa — used by sitemap, robots and canonical URLs.
SITE_URL=
# development | staging | production. Anything but production → noindex (CLAUDE.md §6).
SITE_ENV=development
