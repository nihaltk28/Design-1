{
  "name": "museum",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gen:types": "echo \"TODO: set the .NET Swagger URL — openapi-typescript <SPEC_URL> -o lib/api/generated.ts (CLAUDE.md §1)\" && exit 1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 playwright test layout",
    "token:clamp": "node scripts/clamp.mjs",
    "prepare": "husky",
    "audit": "pnpm audit --prod",
    "secrets": "git ls-files -z | xargs -0 secretlint",
    "types:check": "pnpm gen:types && git diff --exit-code -- lib/api/generated.ts",
    "storybook": "storybook dev -p 6006",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "nuqs": "2.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "schema-dts": "2.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@next/bundle-analyzer": "16.4.3",
    "@playwright/test": "1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/nextjs": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "culori": "4.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "html-validate": "11.16.2",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "secretlint": "13.0.7",
    "sharp": "0.35.5",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vitest-axe": "0.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
